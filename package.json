{
  "name": "@4lch4/logger",
  "displayName": "Logger",
  "version": "3.0.0",
  "description": "Structured logging for Bun and Node.js apps: JSON lines on stdout, Logs to PostHog over OTLP, and errors to PostHog's error tracking.",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/4lch4/Logger",
  "scripts": {
    "build": "tsc",
    "pretest": "npm run build",
    "test": "node --test \"test/**/*.test.mjs\"",
    "pretty": "prettier --write .",
    "lint": "prettier -c .",
    "scan": "snyk monitor && snyk code test",
    "test:bun": "bun run build && bun test"
  },
  "files": ["dist"],
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "logger",
    "log",
    "logging",
    "structured-logging",
    "stdout",
    "posthog",
    "opentelemetry",
    "otlp",
    "error-tracking"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/4lch4/Logger.git"
  },
  "author": {
    "name": "4lch4",
    "email": "hey@4lch4.email",
    "url": "https://4lch4.com"
  },
  "bugs": {
    "email": "bugs@4lch4.email",
    "url": "https://github.com/4lch4/Logger/issues"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "posthog-node": "^5.64.0"
  }
}
