{
  "name": "@4lch4/logger",
  "displayName": "Logger",
  "version": "2.2.0",
  "description": "A small utility for logging to console within NodeJS/TypeScript applications.",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/4lch4/Logger",
  "scripts": {
    "build": "tsc",
    "pretest": "npm run build",
    "test": "node --test",
    "pretty": "prettier --write .",
    "lint": "prettier -c .",
    "scan": "snyk monitor && snyk code test"
  },
  "files": ["dist"],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": ["util", "logger", "log", "logging", "stdout"],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/4lch4/Logger.git"
  },
  "author": {
    "name": "4lch4",
    "email": "hey@4lch4.email",
    "url": "https://4lch4.com"
  },
  "bugs": {
    "email": "bugs@4lch4.email",
    "url": "https://github.com/4lch4/Logger/issues"
  },
  "dependencies": {
    "@axiomhq/winston": "^2.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "typescript": "^7.0.2"
  }
}
